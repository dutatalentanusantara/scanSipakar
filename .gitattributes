# Normalize line endings across all OS
* text=auto

# PHP & web files — always LF
*.php text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.htaccess text eol=lf
*.sh text eol=lf

# Binary files — no diff/merge/eol handling
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp4 binary
*.webp binary
*.svg text eol=lf
