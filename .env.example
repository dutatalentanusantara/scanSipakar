# ==============================================================
# .env.example — Template Konfigurasi Environment
# SALIN file ini menjadi .env dan sesuaikan nilainya
# JANGAN pernah commit .env asli ke repository!
# ==============================================================

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/siantarbarat/'

#--------------------------------------------------------------------
# DATABASE — Sesuaikan dengan konfigurasi lokal Anda
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = siantarbarat
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
