Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    Options +FollowSymlinks
    RewriteEngine On

    # Block direct HTTP access to CI4 internal folders & sensitive directories
    RewriteRule ^(app|vendor|writable|tests|database|scratch|build|builds|_ci4_staging)(/|$) - [F,L,NC]

    # Block hidden dotfiles/dotdirs except ACME verification under .well-known/
    RewriteCond %{REQUEST_URI} !/\.well-known/ [NC]
    RewriteRule (^|/)\. - [F,L]

    # Ensure Authorization header is passed along to PHP / API v1
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct HTTP execution of any .php file other than front controller index.php
    RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php([\s?/]|$) [NC]
    RewriteCond %{THE_REQUEST} !\s/+((siantarbarat/)?index\.php)([\s?/]|$) [NC]
    RewriteRule \.php$ - [F,L,NC]

    # Serve existing physical files and folders (asset/, captcha/, template/, favicon.ico, robots.txt)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

# Block direct HTTP access to config, dependency, backup, and CLI script files
<FilesMatch "(^\.(?!well-known)|^(composer\.(json|lock)|spark|phpunit\.dist\.xml|preload\.php|env|web\.config|db_import\.php|setup_local\.php|database\.local\.php|dir_map\.json)$|\.(sql|log|bak|old|ini|dist|sh|bat|md|rst|lock)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Fallback security headers for static assets served directly by Apache
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always setifempty X-Content-Type-Options "nosniff"
    Header always setifempty X-Frame-Options "SAMEORIGIN"
    Header always setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header always setifempty Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self \"https://www.youtube.com\" \"https://www.youtube-nocookie.com\" \"https://maps.google.com\" \"https://www.google.com\"), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), usb=()"
</IfModule>

ServerSignature Off
